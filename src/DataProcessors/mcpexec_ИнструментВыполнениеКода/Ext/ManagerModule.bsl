// Инструменты execute_query и execute_code для расширения MCP_Сервер (https://github.com/vladimir-kharin/1c_mcp).
// Обработка-контейнер в подсистеме mcpexec_mcp_MCPСервер.mcp_КонтейнерыИнструментов: MCP_Сервер находит ее сам,
// само расширение MCP_Сервер не меняется.
//
// Ответ инструментов - JSON {"success": true, "data": ...} (как у OneBridge). Ссылки - объекты
// {"_objectRef": true, "УникальныйИдентификатор", "ТипОбъекта", "Представление"}, даты - "ГГГГ-ММ-ДДTЧЧ:ММ:СС".
// Ошибка - исключение: MCP_Сервер отдает ее клиенту с признаком isError.
//
// Код и запросы выполняются на сервере под пользователем, который вошел в HTTP-сервис. Пользователь с правом
// «Администрирование» выполняет код без безопасного режима (если компонент установлен без него), остальные -
// в безопасном режиме: без привилегированного режима, файлов, COM и внешних обработок.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментВыполнитьЗапрос(Инструменты);
	ДобавитьИнструментВыполнитьКод(Инструменты);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(Аргументы);
	ИначеЕсли ИмяИнструмента = "execute_code" Тогда
		Возврат ВыполнитьКод(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнструментВыполнитьЗапрос

Процедура ДобавитьИнструментВыполнитьЗапрос(Инструменты)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query",
		"string",
		"Текст запроса на языке запросов 1С. Пакетный запрос возвращает результат последнего запроса пакета.",
		,
		Истина));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"params",
		"object",
		"Параметры запроса: {""ИмяПараметра"": значение}. Значение - строка, число, булево, null, массив (для В (&Список)), "
			+ "дата строкой ""ГГГГ-ММ-ДДTЧЧ:ММ:СС"", ссылка {""_objectRef"": true, ""ТипОбъекта"": ""СправочникСсылка.Контрагенты"", "
			+ """УникальныйИдентификатор"": ""<uuid>""} (как в ответе инструмента; у перечисления - имя значения) или "
			+ "предопределенное значение {""_predefined"": ""Перечисление.ХозяйственныеОперации.РеализацияКлиенту""}."));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit",
		"number",
		"Сколько строк вернуть (0 - все строки)",
		100));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"include_schema",
		"boolean",
		"Добавить в ответ типы колонок (schema)"));

	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_query",
		"Выполняет запрос на языке запросов 1С на сервере под текущим пользователем (с его правами и ограничениями доступа). "
			+ "Ответ - JSON: success, data (массив строк-объектов), count (строк в результате), returned, truncated, schema. "
			+ "Ссылки в data - объекты {_objectRef, УникальныйИдентификатор, ТипОбъекта, Представление}, пустые ссылки - null.",
		mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров));

КонецПроцедуры

Функция ВыполнитьЗапрос(Аргументы)

	ТекстЗапроса = ЗначениеАргумента(Аргументы, "query", "");
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ВызватьИсключение "Не задан текст запроса (query)";
	КонецЕсли;

	Лимит = ЗначениеАргумента(Аргументы, "limit", 100);
	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		ВызватьИсключение "Параметр limit должен быть числом";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	ПараметрыЗапроса = ЗначениеАргумента(Аргументы, "params", Неопределено);
	Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, ЗначениеПараметра(Параметр.Значение));
		КонецЦикла;
	ИначеЕсли ПараметрыЗапроса <> Неопределено Тогда
		ВызватьИсключение "Параметр params должен быть объектом {""ИмяПараметра"": значение}";
	КонецЕсли;

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ВызватьИсключение ТекстОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Выборка = РезультатЗапроса.Выбрать();
	ВсегоСтрок = Выборка.Количество();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Лимит > 0 И Строки.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.Имя, ЗначениеДляПередачи(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", Строки);
	Ответ.Вставить("count", ВсегоСтрок);
	Ответ.Вставить("returned", Строки.Количество());
	Ответ.Вставить("truncated", Строки.Количество() < ВсегоСтрок);
	Если ЗначениеАргумента(Аргументы, "include_schema", Ложь) = Истина Тогда
		Ответ.Вставить("schema", СхемаРезультата(РезультатЗапроса));
	КонецЕсли;

	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Ответ);

КонецФункции

Функция СхемаРезультата(РезультатЗапроса)

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Типы = Новый Массив;
		Для Каждого ТипКолонки Из Колонка.ТипЗначения.Типы() Цикл
			Если ТипКолонки = Тип("Null") Тогда
				Продолжить;
			КонецЕсли;
			Типы.Добавить(ИмяТипа(ТипКолонки));
		КонецЦикла;
		Колонки.Добавить(Новый Структура("name, types", Колонка.Имя, Типы));
	КонецЦикла;

	Возврат Новый Структура("columns", Колонки);

КонецФункции

#КонецОбласти

#Область ИнструментВыполнитьКод

Процедура ДобавитьИнструментВыполнитьКод(Инструменты)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code",
		"string",
		"Код на встроенном языке 1С. Значение для ответа присвоить переменной Результат.",
		,
		Истина));

	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_code",
		"Выполняет код на встроенном языке 1С на сервере (оператор Выполнить) под текущим пользователем и возвращает значение "
			+ "переменной Результат. Код - последовательность операторов: без Процедура/Функция и без Возврат. "
			+ "Ответ - JSON: success, data (значение Результат: примитивы, массивы, структуры, соответствия, таблицы и деревья "
			+ "значений, ссылки {_objectRef, ...}, ДвоичныеДанные - строкой Base64), messages (тексты Сообщить, если были). "
			+ "Пользователь с правом Администрирование выполняет код без безопасного режима, остальные - в безопасном режиме.",
		mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров));

КонецПроцедуры

Функция ВыполнитьКод(Аргументы)

	ТекстКода = ЗначениеАргумента(Аргументы, "code", "");
	Если Не ЗначениеЗаполнено(ТекстКода) Тогда
		ВызватьИсключение "Не задан код (code)";
	КонецЕсли;

	Администратор = ПравоДоступа("Администрирование", Метаданные);
	Если Не Администратор Тогда
		УстановитьБезопасныйРежим(Истина);
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	Попытка
		Значение = РезультатКода(ТекстКода);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Пока ТранзакцияАктивна() Цикл
			ОтменитьТранзакцию();
		КонецЦикла;
		Текст = ТекстОшибки(ИнформацияОбОшибке);
		Сообщения = ТекстыСообщений();
		Если Сообщения.Количество() > 0 Тогда
			Текст = Текст + Символы.ПС + "Сообщения:" + Символы.ПС + СтрСоединить(Сообщения, Символы.ПС);
		КонецЕсли;
		Если Администратор И БезопасныйРежим() <> Ложь Тогда
			Текст = Текст + Символы.ПС
				+ "Расширение MCP_ВыполнениеКода работает в безопасном режиме: снимите у него флажок «Безопасный режим» "
				+ "(Все функции - Стандартные - Управление расширениями конфигурации) и начните новый сеанс.";
		КонецЕсли;
		ВызватьИсключение Текст;
	КонецПопытки;

	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("data", ЗначениеДляПередачи(Значение));
	Сообщения = ТекстыСообщений();
	Если Сообщения.Количество() > 0 Тогда
		Ответ.Вставить("messages", Сообщения);
	КонецЕсли;

	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Ответ);

КонецФункции

// Выполняет код в отдельной функции: коду видны только переменные Результат и ТекстКодаMCP.
//
Функция РезультатКода(Знач ТекстКодаMCP)

	Результат = Неопределено;
	Выполнить(ТекстКодаMCP);
	Возврат Результат;

КонецФункции

// Текст ошибки для ответа: сначала описания по цепочке причин (у ошибки в выполняемом коде - строка кода),
// затем стек вызовов.
//
Функция ТекстОшибки(Информация)

	Строки = Новый Массив;
	Текущая = Информация;
	Пока Текущая <> Неопределено Цикл
		Описание = Текущая.Описание;
		Если Не ЗначениеЗаполнено(Текущая.ИмяМодуля) И Текущая.НомерСтроки > 0 Тогда
			Описание = Описание + " (строка " + Формат(Текущая.НомерСтроки, "ЧГ=") + " кода: "
				+ СокрЛП(Текущая.ИсходнаяСтрока) + ")";
		КонецЕсли;
		Если ЗначениеЗаполнено(Описание) Тогда
			Строки.Добавить(Описание);
		КонецЕсли;
		Текущая = Текущая.Причина;
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить(ПодробноеПредставлениеОшибки(Информация));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстыСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

#КонецОбласти

#Область ПреобразованиеЗначений

Функция ЗначениеАргумента(Аргументы, Имя, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") И Аргументы.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Значение параметра запроса из JSON: ссылки, предопределенные значения, даты строкой, массивы.
//
Функция ЗначениеПараметра(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеПараметра(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ДатаИзСтроки(Значение);
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;

	Если Значение.Свойство("_predefined") Тогда
		Возврат ПредопределенноеЗначение(Значение._predefined);
	КонецЕсли;

	Если Значение.Свойство("_objectRef") И Значение._objectRef = Истина Тогда
		Если Не Значение.Свойство("ТипОбъекта") Или Не Значение.Свойство("УникальныйИдентификатор") Тогда
			ВызватьИсключение "У ссылки в параметре нет ТипОбъекта или УникальныйИдентификатор";
		КонецЕсли;
		Возврат XMLЗначение(Тип(Значение.ТипОбъекта), Значение.УникальныйИдентификатор);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Строка вида ГГГГ-ММ-ДДTЧЧ:ММ:СС (или ГГГГ-ММ-ДД) - дата, иначе строка как есть.
//
Функция ДатаИзСтроки(Строка)

	Длина = СтрДлина(Строка);
	Если (Длина <> 10 И Длина <> 19) Или Сред(Строка, 5, 1) <> "-" Или Сред(Строка, 8, 1) <> "-" Тогда
		Возврат Строка;
	КонецЕсли;
	Если Длина = 19 И (Сред(Строка, 11, 1) <> "T" Или Сред(Строка, 14, 1) <> ":" Или Сред(Строка, 17, 1) <> ":") Тогда
		Возврат Строка;
	КонецЕсли;

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка, "-", ""), "T", ""), ":", ""), " ", "");
	Если СтрДлина(Цифры) <> Длина - ?(Длина = 10, 2, 5) Тогда
		Возврат Строка;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Индекс, 1)) = 0 Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), ?(Длина = 10, Строка + "T00:00:00", Строка));
	Исключение
		Возврат Строка;
	КонецПопытки;

КонецФункции

// Значение 1С в виде, который записывается в JSON (mcp_ОбщегоНазначения.ЗначениеВJSON).
//
Функция ЗначениеДляПередачи(Значение, Глубина = 0)

	Если Глубина > 10 Тогда
		Возврат "<max_depth>";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ЭтоСсылка(ТипЗначения) Тогда
		Если Значение.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("_objectRef", Истина);
		Описание.Вставить("УникальныйИдентификатор", XMLСтрока(Значение));
		Описание.Вставить("ТипОбъекта", ИмяТипа(ТипЗначения));
		Описание.Вставить("Представление", Строка(Значение));
		Возврат Описание;
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеДляПередачи(Элемент, Глубина + 1));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ЗначениеДляПередачи(КлючИЗначение.Значение, Глубина + 1));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Ключ = ?(ТипЗнч(КлючИЗначение.Ключ) = Тип("Строка"), КлючИЗначение.Ключ, Строка(КлючИЗначение.Ключ));
			Результат.Вставить(Ключ, ЗначениеДляПередачи(КлючИЗначение.Значение, Глубина + 1));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			Результат.Добавить(СтрокаДляПередачи(СтрокаТаблицы, Значение.Колонки, Глубина));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("ДеревоЗначений") Тогда
		Возврат СтрокиДереваДляПередачи(Значение.Строки, Значение.Колонки, Глубина);
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Новый Структура("value, presentation",
				ЗначениеДляПередачи(Элемент.Значение, Глубина + 1), Элемент.Представление));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("РезультатЗапроса") Тогда
		Возврат ЗначениеДляПередачи(Значение.Выгрузить(), Глубина);
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Возврат Base64Строка(Значение);
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат "<ХранилищеЗначения>";
	ИначеЕсли ТипЗначения = Тип("Тип") Тогда
		Возврат ИмяТипа(Значение);
	ИначеЕсли ТипЗначения = Тип("ОписаниеТипов") Тогда
		Типы = Новый Массив;
		Для Каждого ТипИзОписания Из Значение.Типы() Цикл
			Типы.Добавить(ИмяТипа(ТипИзОписания));
		КонецЦикла;
		Возврат Типы;
	ИначеЕсли ТипЗначения = Тип("ОбъектМетаданных") Тогда
		Возврат Значение.ПолноеИмя();
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция СтрокаДляПередачи(СтрокаКоллекции, Колонки, Глубина)

	Результат = Новый Структура;
	Для Каждого Колонка Из Колонки Цикл
		Результат.Вставить(Колонка.Имя, ЗначениеДляПередачи(СтрокаКоллекции[Колонка.Имя], Глубина + 1));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокиДереваДляПередачи(СтрокиДерева, Колонки, Глубина)

	Результат = Новый Массив;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		СтрокаРезультата = СтрокаДляПередачи(СтрокаДерева, Колонки, Глубина);
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СтрокаРезультата.Вставить("Строки", СтрокиДереваДляПередачи(СтрокаДерева.Строки, Колонки, Глубина + 1));
		КонецЕсли;
		Результат.Добавить(СтрокаРезультата);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоСсылка(ПроверяемыйТип)

	Возврат Справочники.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Документы.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Задачи.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ПроверяемыйТип);

КонецФункции

// Имя типа для ответа: СправочникСсылка.Контрагенты, Строка, Число…
//
Функция ИмяТипа(ЗначениеТипа)

	Если Не ЭтоСсылка(ЗначениеТипа) Тогда
		Возврат Строка(ЗначениеТипа);
	КонецЕсли;

	МетаданныеТипа = Метаданные.НайтиПоТипу(ЗначениеТипа);
	Если МетаданныеТипа = Неопределено Тогда
		Возврат Строка(ЗначениеТипа);
	КонецЕсли;

	Части = СтрРазделить(МетаданныеТипа.ПолноеИмя(), ".");
	Возврат Части[0] + "Ссылка." + Части[1];

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
